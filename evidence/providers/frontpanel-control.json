  "reproduce": {
    "build": "python build.py frontpanel",
    "provider": "python tuxbox.py verify --only frontpanel --output build/frontpanel-results.json",
    "reference": "Copy frontpanel.exe, the supplied xfrontpaneldisplay.dll and xfp_gc.dll into one folder. Run frontpanel.exe there. For the connected run replace xfp_gc.dll in that temporary folder with build/frontpanel/fixture/xfp_gc.dll and pass --connected."
